<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    common-auth - the authentication stack shared by the apps in this repository.

    WHY THIS EXISTS. RefillRadar v0.4-v0.5 built accounts, sessions and a login
    throttle; SafeWord v0.2 needed the same three things and got them by copy and
    paste. A third copy was where that stopped being acceptable: this is SECURITY
    code, and n copies of a login throttle is exactly how one application silently
    keeps a bug after the others are fixed. The rule of thumb about waiting for a
    third occurrence before abstracting is a good one for ordinary code; for a
    control whose failure is a breach, the second occurrence is the signal.

    WHAT IS NOT HERE, deliberately:
      - Flyway migrations. Each application owns its own version line, and a shared
        migration numbered V1 would collide with whatever that application already
        called V1. The SQL is therefore repeated per app; the Java is not.
      - Authorization rules. Which routes are public is a product decision that
        differs per app - SafeWord deliberately leaves its pause screen open to
        anyone. Only the HARDENING is shared; see AuthHardening.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.commonauth</groupId>
  <artifactId>common-auth</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>common-auth</name>
  <description>Accounts, sessions and login rate limiting, shared across the apps</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- The auth endpoints are a @RestController, so the module needs the web stack. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- The account and attempt tables are mapped here; the migrations that CREATE
         them are not, for the reason given above. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Sessions in the database rather than the container's heap. Part of the shared
         design rather than an app choice: the hardening below assumes the cookie is
         Spring Session's SESSION, not the container's JSESSIONID. -->
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    NO spring-boot-maven-plugin here, on purpose. That plugin repackages the jar into
    an executable fat jar with its classes under BOOT-INF/, which makes the artifact
    unusable as a dependency: consumers compile against it and get "package does not
    exist". A library stays a plain jar.
  -->
</project>
