<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    SafeWord - personal early warning for drug shortages.

    Parent POM inheritance: spring-boot-starter-parent pins consistent, mutually
    compatible versions for every Spring and third-party library we use. This is why
    the <dependency> blocks below carry no <version> tags - the parent decides, so we
    cannot accidentally pair an old Jackson with a new Spring and spend an evening on a
    NoSuchMethodError.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.safeword</groupId>
  <artifactId>safeword</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SafeWord</name>
  <description>Family shield against AI impersonation scams</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- REST endpoints + embedded Tomcat. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation (@NotNull, @Positive) on incoming API payloads. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Accounts, sessions, the login throttle and the shared security hardening.
         Brings spring-boot-starter-security and spring-session-jdbc with it, which is why
         neither is declared here any more: one place decides the auth stack.
         Build it first - `mvn -f libs/common-auth install` - or use the repo-root Docker
         build, which does that for you. -->
    <dependency>
      <groupId>com.commonauth</groupId>
      <artifactId>common-auth</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- JPA + Hibernate. v0.2 moves circles off the heap and into PostgreSQL. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- PostgreSQL driver. Runtime scope: application code never imports it, so compiling
         against it would let a Postgres-only class leak into otherwise portable code. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway owns the schema; Hibernate's ddl-auto stays 'validate'. An ORM that rewrites
         tables at startup can drop a column, and its data, with nobody approving a diff. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>



    <!-- MockMvc support for authenticating as a given user in tests. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito, MockMvc. Test scope only - never shipped. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Produces the executable fat JAR: java -jar target/safeword-0.1.0-SNAPSHOT.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
